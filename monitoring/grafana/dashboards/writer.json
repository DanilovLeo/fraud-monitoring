          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fraud_writer_write_seconds_sum[30s])) / sum(rate(fraud_writer_write_seconds_count[30s]))",
          "legendFormat": "среднее",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
