    {
      "type": "table",
      "title": "Скоры по версиям модели",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Из таблицы scores: сколько скоров посчитала каждая версия и какую долю фрода она нашла.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model_version AS \"Версия\",\n       count(*) AS \"Скоров\",\n       sum(fraud_flag) AS \"С флагом фрода\",\n       round(100.0 * avg(fraud_flag), 3) AS \"Доля фрода, %\",\n       round(avg(score)::numeric, 4) AS \"Средний скор\",\n       min(created_at) AS \"Первый скор\",\n       max(created_at) AS \"Последний скор\"\nFROM scores\nGROUP BY model_version\nORDER BY min(created_at) DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 14,
